{
    "name": "servopa-simulator-api",
    "version": "1.0.0",
    "description": "Backend API for Simulador Servopa",
    "main": "src/index.ts",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "db:setup": "prisma migrate dev --name init"
    },
    "dependencies": {
        "@prisma/client": "^5.10.2",
        "@types/helmet": "^0.0.48",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^20.11.24",
        "prisma": "^5.10.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    }
}