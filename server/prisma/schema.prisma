generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  name          String
  role          String       @default("Consultor") // Consultor, Supervisor, Gerente, Admin
  teamId        String?
  photoUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  simulations   Simulation[]

  @@index([teamId])
}

model Simulation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputs    Json
  outputs   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Insight {
  id        String   @id @default(uuid())
  title     String
  data      Json
  createdAt DateTime @default(now())
}
